{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["packages", "apps/mechanism-explorer/src", "apps/mechanism-explorer/vite.config.ts"],
  "exclude": ["**/node_modules", "**/.sites-runtime", "**/dist"]
}
